{
  "name": "dsh-wish",
  "version": "0.1.0",
  "private": true,
  "description": "Wish-Driven Development (WDD) for DeepSeek Harness — 把一句话需求判成 L0/L1/L2，逼出一份只有一种读法、可被脚本判定（退出码）的验收契约",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "router.py",
    "contract_lint.py",
    "focus.py",
    "deps.py",
    "refs.py",
    "templates",
    "vendor",
    "tools",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "PLAN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tommy1Tang/dsh-wish.git"
  },
  "homepage": "https://github.com/Tommy1Tang/dsh-wish#readme",
  "bugs": {
    "url": "https://github.com/Tommy1Tang/dsh-wish/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wish-driven-development",
    "requirements-engineering",
    "acceptance-criteria",
    "ears",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node --test test/index.test.mjs",
    "python-test": "python run_tests.py",
    "vendor:sync": "python tools/sync_vendor.py",
    "vendor:check": "python tools/sync_vendor.py --check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
